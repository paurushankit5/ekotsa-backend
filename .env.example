NODE_ENV=development
PORT=4000

# Neon / Postgres connection (app runtime + sync)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Comma-separated origins for website + admin
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Auth (required)
JWT_SECRET="change-me-to-a-long-random-secret"
OTP_PEPPER="change-me-otp-pepper"
AUTH_COOKIE_NAME="ekotsa_session"
FRONTEND_URL="http://localhost:3000"

# Device identity
DEVICE_TOKEN_PEPPER="change-me-device-pepper"
DEVICE_LIMIT_DEFAULT=2
DEVICE_AUTH_TOKEN_DAYS=30
ACTIVATION_SESSION_MINUTES=15

# License signing (required for /v1/licenses/*) — run: npm run keys:license
LICENSE_SIGNING_KEY_ID=key_dev_1
LICENSE_ISSUER_VERSION=1
LICENSE_GRACE_DAYS=7
LICENSE_MAX_OFFLINE_DAYS=30
LICENSE_TRIAL_DAYS=21
# LICENSE_SIGNING_PRIVATE_KEY=
# LICENSE_SIGNING_PUBLIC_KEY=

# Wave C — releases (HTTPS installer URL; public metadata hides the URL)
# APP_RELEASE_MANIFEST_JSON='[{"product":"Ekotsa","channel":"stable","version":"0.1.0","platform":"windows","architecture":"x64","installerUrl":"https://cdn.example.com/Ekotsa-Atithi-setup.exe","installerSize":14693845,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","publishedAt":"2026-01-01T00:00:00.000Z","minimumSupportedVersion":"0.1.0","releaseNotesUrl":"https://ekotsa.com/releases/0.1.0","status":"ACTIVE","signingStatus":"UNSIGNED"}]'

# Wave D — payments / local object storage
APP_PUBLIC_URL=http://localhost:4000
STORAGE_BUCKET=payment-proofs
STORAGE_LOCAL_DIR=.storage
PAYMENT_UPI_ID=ekotsa@upi
PAYMENT_PAYEE_NAME=Ekotsa
# PAYMENT_QR_IMAGE_URL=https://cdn.example.com/upi-qr.png

# Wave E — device reset
DEVICE_RESET_COOLDOWN_DAYS=7
DEVICE_RESET_MAX_REQUESTS_30D=2
DEVICE_RESET_REQUIRE_DEVICE_ID=false

# Wave F — contact + notifications
# SMTP_TO=ops@ekotsa.com
# CRON_SECRET=change-me-cron-secret
NOTIFICATIONS_MAX_ATTEMPTS=6

# Google OAuth (optional until you use /api/v1/oauth/google/*)
# Must match Google Cloud Console exactly (canonical path below).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/oauth/google/callback
# If the browser hits the website proxy instead:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/google/callback

# SMTP (optional — without it, OTPs are printed to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Ekotsa <noreply@ekotsa.com>"
# SMTP_SECURE=false
