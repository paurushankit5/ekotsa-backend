# ekotsa-backend — PRODUCTION environment template.
# Set these in the host's secret manager (never commit real values).
# Validate before deploying:  npm run check:env:production -- --env-file=<file>
# The server also refuses to start in production if any check fails.
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # each secret/pepper
#   npm run keys:auth       # AUTH_JWT_KEY_ID + AUTH_JWT_PRIVATE_KEY (session signing, ES256)
#   npm run keys:license    # LICENSE_SIGNING_* (Ed25519) — public key also goes into the desktop build

NODE_ENV=production
PORT=4000
# Number of reverse proxies / load balancers in front of the app (1 on most managed hosts).
TRUST_PROXY_HOPS=1

# --- Database (Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Public URLs ---
FRONTEND_URL=https://www.ekotsa.com
APP_PUBLIC_URL=https://api.ekotsa.com
CORS_ORIGINS=https://www.ekotsa.com,https://admin.ekotsa.com

# --- Secrets (all required, random, >= 32 chars, all different) ---
JWT_SECRET=
OTP_PEPPER=
DEVICE_TOKEN_PEPPER=
CRON_SECRET=

# --- Session signing (ES256). Website verifies via GET /api/v1/auth/jwks ---
AUTH_JWT_KEY_ID=
AUTH_JWT_PRIVATE_KEY=
# During key rotation only: {"<old kid>":"<base64url SPKI>"}
# AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_JWT_ACCEPT_LEGACY_HS256=false

# --- Cookies (must match the website) ---
AUTH_COOKIE_NAME=ekotsa_session
ADMIN_AUTH_COOKIE_NAME=ekotsa_admin_session

# --- Licence signing (Ed25519). Desktop build needs the matching public key ---
LICENSE_SIGNING_KEY_ID=key_2026_11
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_ISSUER_VERSION=1
LICENSE_GRACE_DAYS=7
LICENSE_MAX_OFFLINE_DAYS=30
LICENSE_TRIAL_DAYS=21

# --- Devices ---
DEVICE_LIMIT_DEFAULT=2
DEVICE_AUTH_TOKEN_DAYS=30
ACTIVATION_SESSION_MINUTES=15
DEVICE_RESET_COOLDOWN_DAYS=7
DEVICE_RESET_MAX_REQUESTS_30D=2
DEVICE_RESET_REQUIRE_DEVICE_ID=false

# --- Google sign-in (callback goes through the website, which proxies /api/v1) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.ekotsa.com/api/v1/oauth/google/callback

# --- Email (OTP, password reset, contact notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@ekotsa.com
SMTP_TO=admin@ekotsa.com
NOTIFICATIONS_MAX_ATTEMPTS=6

# --- Installer storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ekotsa-downloads
# R2_PUBLIC_BASE_URL=https://downloads.ekotsa.com

# --- Rate limiting ---
# Default: Postgres table rate_limit_counters (no extra service). Optional Upstash instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Must stay OFF in production (startup refuses otherwise) ---
LOCAL_DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_CONFIRM_DISPOSABLE=false
